[Unit]
Description=Vinted basic_5_giant_model scoring loop (reporting + dry-run comparison; vinted-visual-scoring is the live Telegram sender)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Vinted_New_Version
ExecStart=%h/miniconda3/envs/vinted_scraper/bin/python experiments/current/basic_5_giant_model/apply_to_live_collector.py --live-run-dir experiments/current/time_to_sell/data/live_runs/bin_collector_20260602_214104 --run-loop --telegram-dry-run
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
MemoryMax=1500M
MemorySwapMax=500M
RuntimeMaxSec=12h

[Install]
WantedBy=default.target
