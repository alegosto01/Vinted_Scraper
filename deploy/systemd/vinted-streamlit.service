[Unit]
Description=Vinted Streamlit dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Vinted_New_Version
# Bind localhost only; reach it via SSH tunnel (see README_DEPLOY.md).
ExecStart=%h/miniconda3/envs/vinted_scraper/bin/python -m streamlit run app.py --server.headless true --server.address 127.0.0.1 --server.port 8501
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
MemoryMax=2G
RuntimeMaxSec=24h

[Install]
WantedBy=default.target
