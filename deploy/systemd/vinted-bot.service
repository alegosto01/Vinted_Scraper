[Unit]
Description=Vinted Telegram bot (polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Vinted_New_Version
ExecStart=%h/miniconda3/envs/vinted_scraper/bin/python scripts/telegram_implementation/bot.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
MemoryMax=800M
MemorySwapMax=300M
RuntimeMaxSec=12h

[Install]
WantedBy=default.target
